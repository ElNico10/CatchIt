@page
@model CatchIt.Web.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}
<h1>Create an account</h1>
<form method="post">
    <p><label for="name">Name (optional)</label><br /><input id="name" name="Name" value="@Model.Name" /></p>
    <p><label for="email">Email</label><br /><input id="email" name="Email" type="email" value="@Model.Email" /></p>
    <p><label for="password">Password</label><br /><input id="password" name="Password" type="password" /></p>
    <button type="submit" id="submit">Register</button>
    @if (Model.Error is { } error)
    {
        <p class="error" id="error" role="alert">@error</p>
    }
</form>
<p><a href="/Login">Already have an account? Log in</a></p>
