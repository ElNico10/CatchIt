@page
@model CatchIt.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Search";
}
<h1>Find the best price</h1>
<form method="get">
    <label for="q">Product, brand or keyword</label>
    <input id="q" name="q" value="@Model.Q" autofocus />
    <label for="tier">Brand tier</label>
    <select id="tier" name="tier">
        <option value="">Any</option>
        @foreach (var t in new[] { 1, 2, 3 })
        {
            <option value="@t" selected="@(Model.Tier == t)">@Format.Tier(t)</option>
        }
    </select>
    <label for="minrating">Seller rating</label>
    <select id="minrating" name="minRating">
        <option value="">Any</option>
        @foreach (var r in new[] { 3.0, 4.0, 4.5 })
        {
            <option value="@r" selected="@(Model.MinRating == r)">@r.ToString("0.0")+</option>
        }
    </select>
    <button type="submit" id="search">Search</button>
</form>

@if (Model.Result is { } found)
{
    if (!found.TextMatchedAnyProduct)
    {
        <p id="status">No products found</p>
    }
    else if (found.Hits.Count == 0)
    {
        <p id="status">No products match your filters</p>
    }
    else
    {
        <p id="status">Showing @found.Hits.Count of @found.TotalListings listings, cheapest first.</p>
        <table id="results">
            <thead><tr><th>Product</th><th>Brand</th><th>Marketplace</th><th>Seller rating</th><th>Price</th></tr></thead>
            <tbody>
            @foreach (var hit in found.Hits)
            {
                <tr>
                    <td><a href="/Product?id=@hit.ListingId">@hit.ProductName</a> @if (hit.OnSale) { <span class="sale">On Sale</span> }</td>
                    <td>@hit.BrandName</td>
                    <td>@hit.MarketplaceName</td>
                    <td>@hit.SellerRating.ToString("0.0")</td>
                    <td>@Format.Money(hit.CurrentPrice)</td>
                </tr>
            }
            </tbody>
        </table>
    }
}
