@page
@model CatchIt.Web.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}
<h1>Reset your password</h1>
<p>There is no real email server, so the email appears below instead of in your inbox.</p>
<form method="post" asp-page-handler="Send">
    <p><label for="email">Email</label><br /><input id="email" name="Email" type="email" value="@Model.Email" /></p>
    <button type="submit" id="send">Send me a code</button>
</form>
@if (Model.Mail is { } mail)
{
    <div class="email" id="email-box">
        To: @mail.Email<br />
        Subject: Reset your CatchIt password<br />
        Your password reset code is: <code id="code">@mail.Code</code>
    </div>
}
<form method="post" asp-page-handler="Reset">
    <input type="hidden" name="Email" value="@Model.Email" />
    <p><label for="codebox">Code</label><br /><input id="codebox" name="Code" autocomplete="off" /></p>
    <p><label for="newpassword">New password</label><br /><input id="newpassword" name="NewPassword" type="password" /></p>
    <p><label for="confirmpassword">New password again</label><br /><input id="confirmpassword" name="ConfirmPassword" type="password" /></p>
    <button type="submit" id="reset">Reset password</button>
</form>
@if (Model.Message is { } message)
{
    <p class="ok" id="message">@message</p>
}
@if (Model.Error is { } error)
{
    <p class="error" id="error" role="alert">@error</p>
}
<p><a href="/Login">Back to log in</a></p>
